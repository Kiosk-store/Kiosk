# ==============================================================================
# KIOSK ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env for local development
# ==============================================================================

# 1. APPLICATION BASE CONFIGURATION
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 2. DATABASE PERSISTENCE (Neon PostgreSQL / AWS Aurora)
# Connection pool string for PgBouncer / Neon Drizzle client
DATABASE_URL="postgres://postgres:postgres@localhost:5432/kiosk"

# 3. AUTHENTICATION & JWT SECURITY (Auth.js v5 / NextAuth)
# Generate a secret via: npx auth secret
AUTH_SECRET="kiosk_super_secret_jwt_key_2026_change_in_production"
AUTH_URL="http://localhost:3000"

# 4. OAUTH 2.0 IDENTITY PROVIDERS
# Obtain keys from Google Cloud Console -> APIs & Services -> Credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Obtain keys from GitHub Developer Settings -> OAuth Apps
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# 5. DISTRIBUTED CACHING & RATE LIMITING (Upstash Redis)
# Obtain from Upstash Console -> Redis Database
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# 6. PAYMENTS & SUBSCRIPTIONS (Flutterwave, Stripe, Paystack)
# Obtain from Flutterwave Dashboard -> Settings -> API Keys & Webhooks
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-your_flutterwave_public_key-X"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your_flutterwave_secret_key-X"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TEST_encryption_key"
FLUTTERWAVE_SECRET_HASH="your_flutterwave_webhook_secret_hash"

# Obtain from Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Obtain from Paystack Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# 7. EMAIL & TRANSACTIONAL NOTIFICATIONS (Resend)
# Obtain from Resend Dashboard -> API Keys
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Kiosk <noreply@kiosk.site>"

# 8. WILDCARD SUBDOMAIN PROVISIONING (Vercel & Cloudflare)
VERCEL_AUTH_TOKEN="your_vercel_auth_token"
VERCEL_PROJECT_ID="your_vercel_project_id"
VERCEL_TEAM_ID="your_vercel_team_id"
