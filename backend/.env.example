PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://kiosk_admin:kiosk_secure_password@localhost:5432/kiosk_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication JWT
JWT_ACCESS_SECRET=kiosk_super_secret_jwt_access_key_change_in_production_12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=kiosk_super_secret_jwt_refresh_key_change_in_production_67890
JWT_REFRESH_EXPIRATION=7d

# AWS S3 / Cloudflare R2
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_BUCKET_NAME=kiosk-assets-bucket

# Stripe
STRIPE_SECRET_KEY=sk_test_mock_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret
